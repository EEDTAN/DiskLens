{
  "name": "disklens",
  "version": "0.3.0",
  "description": "Disk space analyzer with a File Explorer feel. See what is big, and learn what happens before you delete it.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "author": "EEDTAN",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "homepage": "https://github.com/EEDTAN/DiskLens",
  "repository": {
    "type": "git",
    "url": "https://github.com/EEDTAN/DiskLens.git"
  },
  "bugs": {
    "url": "https://github.com/EEDTAN/DiskLens/issues"
  },
  "keywords": [
    "disk",
    "disk-usage",
    "disk-analyzer",
    "file-explorer",
    "electron",
    "windows"
  ],
  "build": {
    "appId": "io.github.eedtan.disklens",
    "productName": "DiskLens",
    "copyright": "Copyright (c) 2026 EEDTAN",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "LICENSE",
      "build/icon.png",
      "dups.js",
      "main.js",
      "ops.js",
      "package.json",
      "preload.js",
      "rules.js",
      "scanner.js",
      "src/**/*",
      "updater.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DiskLens-Setup.exe",
      "license": "LICENSE"
    },
    "portable": {
      "artifactName": "DiskLens-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "EEDTAN",
        "repo": "DiskLens",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
